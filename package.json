{
  "name": "game-pipeline-agents",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered virtual game studio for Cocos WeChat mini-game delivery.",
  "type": "module",
  "bin": {
    "game-pipeline-agents": "./bin/game-pipeline-agents.js"
  },
  "scripts": {
    "build": "tsc -b packages/shared-schemas packages/agent-runtime apps/api",
    "typecheck": "tsc -b packages/shared-schemas packages/agent-runtime apps/api --pretty false",
    "verify:agent-loop": "npm run build && node scripts/verify-agent-loop.mjs",
    "verify:agent-pool": "npm run build && node scripts/verify-agent-execution-pool.mjs",
    "verify:agent-worker": "npm run build && node scripts/verify-agent-worker.mjs",
    "verify:agent-skills": "npm run build && node scripts/verify-agent-skills.mjs",
    "verify:artifact-provenance": "npm run build && node scripts/verify-artifact-provenance.mjs",
    "verify:api-security": "npm run build && node scripts/verify-api-security.mjs",
    "verify:asset-raster": "npm run build && node scripts/verify-asset-raster.mjs",
    "verify:asset-alpha": "npm run build && node scripts/verify-image-asset-alpha.mjs",
    "verify:claude-harness": "npm run build && node scripts/verify-claude-harness.mjs",
    "verify:harness-authorization": "npm run build && node scripts/verify-harness-mcp-authorization.mjs",
    "verify:contracts": "npm run build && node scripts/verify-game-contracts.mjs",
    "verify:contract-gates": "npm run build && node scripts/verify-contract-artifact-gates.mjs",
    "verify:contract-qa-gate": "npm run build && node scripts/verify-contract-qa-gate.mjs",
    "verify:idea-templates": "npm run build && node scripts/verify-idea-templates.mjs",
    "verify:playtest-contract": "npm run build && node scripts/verify-playtest-contract-runner.mjs",
    "verify:persistence": "npm run build && node scripts/verify-project-persistence.mjs",
    "verify:production-audit": "npm run build && node scripts/verify-production-audit.mjs",
    "verify:path-safety": "npm run build && node scripts/verify-path-safety.mjs",
    "verify:release-topology": "npm run build && node scripts/verify-release-topology.mjs",
    "verify:workflow": "npm run build && node scripts/verify-workflow-aggregate.mjs",
    "verify:workspace-isolation": "npm run build && node scripts/verify-workspace-isolation.mjs",
    "verify:cocos-bridge": "npm run build && node scripts/verify-cocos-engine-bridge.mjs",
    "verify:claim-repair": "npm run build && node scripts/verify-claim-repair.mjs",
    "verify:concurrent-room": "npm run build && node scripts/verify-concurrent-room-replies.mjs",
    "verify:dashboard-progress": "node scripts/verify-dashboard-progress.mjs",
    "verify:memory-view": "npm run build && node scripts/verify-memory-view.mjs",
    "verify:qa-gate": "npm run build && node scripts/verify-qa-playtest-gate.mjs",
    "verify:room-gates": "npm run build && node scripts/verify-room-gates.mjs",
    "verify:model-streaming": "npm run build && node scripts/verify-model-client-streaming.mjs",
    "verify:multimodal-art": "npm run build && node scripts/verify-multimodal-art-provider.mjs",
    "verify:vision-binding": "npm run build && node scripts/verify-vision-semantic-binding.mjs",
    "verify:quality-contract": "npm run build && node scripts/verify-quality-review-contract.mjs",
    "verify:quality-gates": "npm run build && node scripts/verify-quality-gate-and-assets.mjs",
    "verify:session-context": "npm run build && node scripts/verify-session-context.mjs",
    "verify:session-runtime": "npm run build && node scripts/verify-session-runtime.mjs",
    "verify:stage-one-gate-evidence": "npm run build && node scripts/verify-stage-one-gate-evidence.mjs",
    "verify:store-evidence": "npm run build && node scripts/verify-store-evidence-reconciliation.mjs",
    "verify:tool-authorization": "npm run build && node scripts/verify-tool-authorization.mjs",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo apps/*/dist apps/*/*.tsbuildinfo",
    "start": "node ./bin/game-pipeline-agents.js",
    "start:local": "node ./bin/game-pipeline-agents.js",
    "dev:api": "npm --workspace @game-pipeline/api run dev",
    "demo": "npm --workspace @game-pipeline/api run demo"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
